# =============================================================================
# Fajita environment configuration (EXAMPLE ONLY)
# Copy to .env for Docker self-host or .env.local for local development.
# Never commit real credentials.
# =============================================================================

# -----------------------------------------------------------------------------
# Deployment mode
# -----------------------------------------------------------------------------
# cloud (default): Fajita Cloud production behavior
# self_hosted: operator-run install without Fajita-owned credentials
FAJITA_DEPLOYMENT_MODE=cloud

# Optional: explicit analytics/telemetry opt-in for self-hosted (default off)
# FAJITA_ANALYTICS_ENABLED=0
# FAJITA_TELEMETRY_ENABLED=0

# Optional: allow monitoring private/link-local addresses (default false)
# FAJITA_ALLOW_PRIVATE_NETWORKS=false
# FAJITA_ALLOWED_PRIVATE_CIDRS=10.0.0.0/8,192.168.0.0/16

# -----------------------------------------------------------------------------
# Application
# -----------------------------------------------------------------------------
# Public URL of your deployment (marketing + app links, Stripe redirects).
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Open-source launch flag (marketing site). When false, /open-source and
# /self-host are noindex and GitHub CTAs are hidden. Set true on launch day.
NEXT_PUBLIC_OSS_LAUNCHED=false

# Origin for links in outbound email. Set to your production URL in hosted
# environments. Falls back to NEXT_PUBLIC_APP_URL when unset.
# EMAIL_LINK_ORIGIN=https://your-domain.example

# Optional: HTTP User-Agent for monitor cron requests.
# MONITOR_HTTP_USER_AGENT=Fajita-Monitor/1.0 (+https://your-domain.example/monitoring)

# -----------------------------------------------------------------------------
# Database (Supabase / Postgres)
# -----------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
# Server-only PostgREST URL when it differs from the browser (Docker Compose: http://rest:3000)
# SUPABASE_URL=http://rest:3000
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
DATABASE_URL=postgresql://postgres:your-password@db.your-project-ref.supabase.co:5432/postgres

# Optional: pooler URL construction for Vercel cron monitor worker.
# SUPABASE_PROJECT_REF=your-project-ref
# SUPABASE_DB_REGION=us-east-2
# SUPABASE_POOLER_HOST=aws-1-us-east-2.pooler.supabase.com

# Supabase CLI (migrations only; not required to boot the app).
# SUPABASE_ACCESS_TOKEN=your-supabase-access-token

# -----------------------------------------------------------------------------
# Authentication (Clerk)
# -----------------------------------------------------------------------------
# Local: use Clerk development instance (pk_test_ / sk_test_).
# Production: pk_live_ / sk_live_ only in deployed environment.
# CLERK_WEBHOOK_SIGNING_SECRET must match the Clerk dashboard webhook for /api/webhooks/clerk.
# Local dev requires an HTTPS tunnel (ngrok, Cloudflare Tunnel, etc.) so Clerk can reach your machine.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_your-publishable-key
CLERK_SECRET_KEY=sk_test_your-secret-key
CLERK_WEBHOOK_SIGNING_SECRET=whsec_your-clerk-webhook-signing-secret
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/login
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/signup
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/app
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/app

# Platform administration (Fajita Cloud operators). Comma-separated Clerk user ids.
# Empty = no platform admins (safe default for self-host).
PLATFORM_ADMIN_USER_IDS=

# Optional: require Clerk step-up for high-risk platform actions in production.
# FAJITA_ENFORCE_STEP_UP=1

# -----------------------------------------------------------------------------
# Encryption
# -----------------------------------------------------------------------------
# AES-256-GCM keyring for monitor secrets and subscriber email encryption.
# Format: "1:<base64 of 32 raw bytes>,2:<...>". Generate per deployment; keep old ids when rotating.
# Loss or rotation without old versions makes existing encrypted monitor data unrecoverable.
MONITOR_SECRET_KEYRING=1:your-base64-encoded-32-byte-key

# -----------------------------------------------------------------------------
# Monitoring workers
# -----------------------------------------------------------------------------
# Vercel Cron authentication (GET /api/cron/tick, /api/cron/monitor-tick).
# Self-hosted: same secret for the scheduler sidecar and manual curl health checks.
CRON_SECRET=your-long-random-cron-secret

# Optional: customize Vercel cron monitor worker registration.
# MONITOR_CRON_WORKER_KEY=vercel-cron
# MONITOR_CRON_REGION=us-east
# MONITOR_CRON_VERSION=1.0.0
# MONITOR_CRON_LEASE_BATCH=15
# MONITOR_CRON_LEASE_SECONDS=55

# Optional: published status-page slug for service status at /status (Fajita Cloud).
# FAJITA_SERVICE_STATUS_SLUG=

# -----------------------------------------------------------------------------
# Status pages (hosting)
# -----------------------------------------------------------------------------
# Hosted subdomain zone (default: status.fajita.io on Fajita Cloud).
# NEXT_PUBLIC_STATUS_PAGE_DOMAIN=status.your-domain.example
# NEXT_PUBLIC_STATUS_CNAME_TARGET=cname.status.your-domain.example

# -----------------------------------------------------------------------------
# Email (Resend or SMTP)
# -----------------------------------------------------------------------------
# Optional: unset = email alerts/subscribers report "not configured".
# Resend (HTTP API):
RESEND_API_KEY=re_your-resend-send-key
# RESEND_FULL_API_KEY=re_your-resend-full-access-key
ALERT_EMAIL_FROM=Fajita <alerts@your-domain.example>

# SMTP (self-hosted alternative when RESEND_API_KEY is unset):
# Port 587 = STARTTLS (upgrade after connect). Port 465 = implicit TLS (SMTPS).
# See docs/self-hosting/TROUBLESHOOTING.md#smtp-starttls-vs-smtps-port-587-vs-465
# SMTP_HOST=smtp.your-domain.example
# SMTP_PORT=587
# SMTP_USER=your-smtp-user
# SMTP_PASSWORD=your-smtp-password
# SMTP_FROM=Fajita <alerts@your-domain.example>

# Subscriber email webhook signing (Resend/Svix). Unset = callback fails closed.
SUBSCRIBER_EMAIL_WEBHOOK_SECRET=whsec_your-resend-webhook-signing-secret

# -----------------------------------------------------------------------------
# Alert / subscriber / lifecycle / affiliate workers
# -----------------------------------------------------------------------------
# Bearer tokens for POST /api/internal/*/run. Unset = route disabled.
ALERT_WORKER_TOKEN=
SUBSCRIBER_WORKER_TOKEN=
LIFECYCLE_WORKER_TOKEN=
AFFILIATE_WORKER_TOKEN=
PLATFORM_ANALYTICS_WORKER_TOKEN=

# Affiliate program (optional).
AFFILIATE_COOKIE_SECRET=
STRIPE_CONNECT_CLIENT_ID=

# -----------------------------------------------------------------------------
# Stripe (billing — optional for self-host)
# -----------------------------------------------------------------------------
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_your-publishable-key
STRIPE_SECRET_KEY=sk_test_your-secret-key
STRIPE_WEBHOOK_SECRET=whsec_your-webhook-secret
# FAJITA_STRIPE_ACCOUNT_ID=acct_your-stripe-account-id
# BILLING_BETA_GRANT_ENABLED=true
# BILLING_ENFORCEMENT_ENABLED=true
# STRIPE_LIVE_PAYMENTS_READY=true

# -----------------------------------------------------------------------------
# Analytics (optional)
# -----------------------------------------------------------------------------
# DataFast — unset = analytics scripts disabled.
NEXT_PUBLIC_DATAFAST_WEBSITE_ID=dfid_your-website-id
NEXT_PUBLIC_DATAFAST_DOMAIN=your-domain.example
DATAFAST_API_KEY=df_your-website-api-key
# DATAFAST_BOT_TOKEN=dfbot_your-bot-token
# DATAFAST_WEBSITE_ID=your-admin-website-object-id

# Google Analytics — unset = GA disabled.
NEXT_PUBLIC_GA_MEASUREMENT_ID=G-XXXXXXXXXX

# -----------------------------------------------------------------------------
# Error monitoring (Sentry — optional)
# -----------------------------------------------------------------------------
# SENTRY_DSN=https://your-key@o000.ingest.sentry.io/000
# NEXT_PUBLIC_SENTRY_DSN=https://your-key@o000.ingest.sentry.io/000
# SENTRY_AUTH_TOKEN=
# SENTRY_ORG=
# SENTRY_PROJECT=

# -----------------------------------------------------------------------------
# AI / support (optional)
# -----------------------------------------------------------------------------
# Ask Fajita (Anthropic). Unset = chat disabled.
ANTHROPIC_API_KEY=sk-ant-your-api-key
# FAJITA_CHAT_ANTHROPIC_MODEL=claude-haiku-4-5-20251001

# Genius in-app feedback (optional).
# NEXT_PUBLIC_GENIUS_PROJECT_KEY=gen_pk_your-key

# Pamphlet support (optional).
# PAMPHLET_ENABLED=false
# PAMPHLET_API_BASE_URL=
# PAMPHLET_API_KEY=

# -----------------------------------------------------------------------------
# Cloud DNS / email setup scripts (optional)
# -----------------------------------------------------------------------------
# CLOUDFLARE_API_TOKEN=
# CLOUDFLARE_ZONE_ID=your-cloudflare-zone-id
# CLOUDFLARE_ACCOUNT_ID=your-cloudflare-account-id
# RESEND_DOMAIN=your-domain.example
# DMARC_RUA_EMAIL=alerts@your-domain.example

# -----------------------------------------------------------------------------
# Development tooling (optional)
# -----------------------------------------------------------------------------
# BRAND_LAB_ENABLED=true
# NEXT_PUBLIC_PRODUCT_HUNT_URL=
# FAJITA_PROMO_CODES=

# -----------------------------------------------------------------------------
# Production smoke / launch fixtures (operators only)
# -----------------------------------------------------------------------------
# SMOKE_BASE_URL=https://your-domain.example
# SMOKE_USER_ID=
# SMOKE_ORG_ID=
# EMAIL_TEST_TO=
# LAUNCH_ALERT_TEST_EMAIL=
# VERCEL_TEAM_SLUG=
# DEBUG_ORG_ID=
# DEBUG_WORKER_ID=
# LAUNCH_ALERT_TEST_SLACK_WEBHOOK=
# LAUNCH_ALERT_TEST_DISCORD_WEBHOOK=
# LAUNCH_ALERT_TEST_WEBHOOK_URL=
# RUN_PRODUCTION_SEED=1

# -----------------------------------------------------------------------------
# Self-hosted Docker Compose (optional)
# -----------------------------------------------------------------------------
# POSTGRES_PASSWORD=postgres
# POSTGRES_PORT=5432
# WEB_PORT=3000
# POSTGREST_PORT=54321
# MONITOR_WORKER_PORT=8080
# SUPABASE_JWT_SECRET=super-secret-jwt-token-with-at-least-32-characters-long
# MONITOR_WORKER_KEY=selfhost-primary
# MONITOR_WORKER_REGION=local
# SCHEDULER_INTERVAL_SECONDS=60
# DEMO_SEED_ENABLED=1

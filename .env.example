# Headroom (local token compression proxy)
# Copy to .env.local only if you need these in shell scripts; Cursor reads MCP + UI settings.

HEADROOM_PORT=8787
HEADROOM_PROJECT_SLUG=fajita-io
HEADROOM_TELEMETRY=off
HEADROOM_OUTPUT_SHAPER=1

# Optional: trim model output verbosity after sessions are mined
# HEADROOM_VERBOSITY_LEVEL=terse

# Cursor proxy base URLs (configure in Cursor Settings > Models)
# OPENAI_BASE_URL=http://127.0.0.1:8787/p/fajita-io/v1
# ANTHROPIC_BASE_URL=http://127.0.0.1:8787/p/fajita-io

# Anthropic (Claude API). Server only. Powers Ask Fajita streaming chat.
ANTHROPIC_API_KEY=sk-ant-your-api-key
# Optional model override for Ask Fajita (default: claude-haiku-4-5-20251001)
# FAJITA_CHAT_ANTHROPIC_MODEL=claude-haiku-4-5-20251001

# DataFast (analytics)
NEXT_PUBLIC_DATAFAST_WEBSITE_ID=dfid_xLc2ttRXakQUhrp4aV9xj
NEXT_PUBLIC_DATAFAST_DOMAIN=fajita.io

# Google Analytics (GA4). Public measurement ID. Leave empty to disable.
NEXT_PUBLIC_GA_MEASUREMENT_ID=G-6G1L4QF863
# Website API key (Website Settings > API). Server-side goals only.
DATAFAST_API_KEY=df_your-website-api-key
# Optional: Bot traffic auth token (Bot traffic card settings). Server only.
# DATAFAST_BOT_TOKEN=dfbot_your-bot-token

# App URL (used for Stripe Checkout success/cancel redirects)
NEXT_PUBLIC_APP_URL=https://fajita.io

# Resend full-access key for domain/DNS scripts only (never commit).
# RESEND_FULL_API_KEY=re_your-full-access-key
# DMARC_RUA_EMAIL=alerts@fajita.io
# CLOUDFLARE_API_TOKEN=
# CLOUDFLARE_ZONE_ID=0e44cc835b97bd56dc0b6731b099fb34
# CLOUDFLARE_ACCOUNT_ID=e4f4f02d85a43769e102a361824dfc60

# Stripe (Billing + Invoicing). Server keys are secret.
# Use a dedicated Fajita Stripe account. Do not reuse unrelated product keys.
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_your-publishable-key
# Stripe (Fajita account only — not Learn Domains or other Accomplish products)
STRIPE_SECRET_KEY=sk_test_your-secret-key
STRIPE_WEBHOOK_SECRET=whsec_your-webhook-secret
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_your-publishable-key
# Optional guard: refuse seed/verify if STRIPE_SECRET_KEY is not this account
# FAJITA_STRIPE_ACCOUNT_ID=acct_your-fajita-account-id
STRIPE_WEBHOOK_SECRET=whsec_your-webhook-secret
# Set true only after npm run stripe:verify-prices and real-payment-test pass.
# BILLING_ENFORCEMENT_ENABLED=false

# Error monitoring (Sentry). Unset = SDK disabled (no events sent).
# Create a Fajita project at sentry.io; set both in Vercel Production.
# SENTRY_DSN=https://your-key@o000.ingest.sentry.io/000
# NEXT_PUBLIC_SENTRY_DSN=https://your-key@o000.ingest.sentry.io/000
# Optional source-map upload (CI/CD only; never commit the token).
# SENTRY_AUTH_TOKEN=
# SENTRY_ORG=
# SENTRY_PROJECT=

# Clerk
# Local: use the Fajita *development* instance (pk_test_ / sk_test_).
# Production: use pk_live_ / sk_live_ only in the deployed environment.
# Do not export live Clerk keys into your shell; they override .env.local and
# break localhost signup. `npm run dev` unsets shell Clerk keys for this reason.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_your-publishable-key
CLERK_SECRET_KEY=sk_test_your-secret-key
# Signing secret for the Clerk webhook (Clerk Dashboard > Webhooks > endpoint).
CLERK_WEBHOOK_SIGNING_SECRET=whsec_your-clerk-webhook-signing-secret
# Where Clerk sends users after auth (must match app routes).
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/login
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/signup
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/app
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/app

# Platform administration. Comma-separated Clerk user ids (user_xxx) that hold
# the internal platform-admin role. Empty = no admins. Never a public email
# domain suffix; never a password. See docs/security/platform-admin-foundation.md
PLATFORM_ADMIN_USER_IDS=

# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-publishable-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
DATABASE_URL=postgresql://postgres:your-password@db.your-project-ref.supabase.co:5432/postgres
SUPABASE_PROJECT_REF=your-project-ref
SUPABASE_ACCESS_TOKEN=your-supabase-access-token

# Monitor + subscriber secret encryption (AES-256-GCM keyring). Versioned:
# "1:<base64 of 32 raw bytes>,2:<...>". Highest version encrypts new data; older
# versions stay to decrypt existing rows during rotation. Subscriber email
# addresses and preference-link signing keys are derived from this ring.
MONITOR_SECRET_KEYRING=1:your-base64-encoded-32-byte-key

# Transactional email (Resend). Shared by team alerts (Phase 7) and status-page
# subscriber email (Phase 9). Server only.
RESEND_API_KEY=re_your-resend-api-key
ALERT_EMAIL_FROM=Fajita <alerts@fajita.io>

# Status-page subscriber system (Phase 9). All optional; unset degrades safely.
# Bearer token for POST /api/internal/subscribers/run (standalone worker or cron).
SUBSCRIBER_WORKER_TOKEN=
# Svix/Resend signing secret for POST /api/webhooks/subscriber-email (bounce +
# complaint + delivered callbacks). Unset = the callback endpoint fails closed.
SUBSCRIBER_EMAIL_WEBHOOK_SECRET=whsec_your-resend-webhook-signing-secret

# Onboarding + lifecycle system (Phase 11). Bearer token for
# POST /api/internal/lifecycle/run (rule evaluation, email delivery, weekly
# reports, incident recaps, reconciliation). Unset = trigger route disabled.
LIFECYCLE_WORKER_TOKEN=

# Affiliate program (Phase 12). All optional; unset degrades safely.
# AFFILIATE_COOKIE_SECRET: HMAC key that signs the first-party referral cookie.
#   Required in production for tamper-resistant attribution.
# AFFILIATE_WORKER_TOKEN: bearer token for POST /api/internal/affiliates/run
#   (commission maturation, window expiry). Unset = trigger route disabled.
# STRIPE_CONNECT_CLIENT_ID: Stripe Connect platform client id for Express payout
#   onboarding. Unset = payouts fall back to manual settlement by an operator.
AFFILIATE_COOKIE_SECRET=
AFFILIATE_WORKER_TOKEN=
STRIPE_CONNECT_CLIENT_ID=

# Vercel Cron (GET /api/cron/tick). Set the same value in the Vercel project
# env so scheduled runs send Authorization: Bearer <CRON_SECRET>.
CRON_SECRET=

# Fajita service status (fajita.io/status). Slug of the published internal
# status page. When set and public, /status serves the live snapshot.
# FAJITA_SERVICE_STATUS_SLUG=

# Genius in-app feedback (authenticated app only). Public publishable key from
# the Fajita project install page at https://genius.ly (not a placeholder).
# NEXT_PUBLIC_GENIUS_PROJECT_KEY=gen_pk_live_...

# Pamphlet support chatbot (Phase 16). All optional.
# As of 2026-07-17 there is no verified public Pamphlet chatbot API/SDK in this
# repository. Leave unset for honest disabled provider sync/handoff. Ask Fajita
# still answers from approved Fajita knowledge and shows Powered by Pamphlet.
# Never put PAMPHLET_API_KEY in NEXT_PUBLIC_* variables.
# PAMPHLET_ENABLED=false
# PAMPHLET_API_BASE_URL=
# PAMPHLET_API_KEY=
# PAMPHLET_WEBHOOK_SECRET=
# PAMPHLET_PUBLIC_CHATBOT_ID=
# PAMPHLET_AUTH_CHATBOT_ID=
# PAMPHLET_WORKSPACE_ID=
# PAMPHLET_KNOWLEDGE_COLLECTION_ID=
# NEXT_PUBLIC_PAMPHLET_PUBLIC_CHATBOT_ID=

# Alert delivery worker (POST /api/internal/alerts/run). Optional when using
# the unified cron tick above.
ALERT_WORKER_TOKEN=

# Platform operations analytics (Phase 17). Bearer token for
# POST /api/internal/platform/run (daily health, org health snapshots).
# Unset = trigger route returns 404.
PLATFORM_ANALYTICS_WORKER_TOKEN=

# Enforce Clerk reverification for high-risk platform actions (approvals,
# drains, exports). Set to 1 in production when reverification is configured.
# FAJITA_ENFORCE_STEP_UP=1

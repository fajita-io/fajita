# Worker image for long-running Node processes (alert, subscriber, lifecycle).
FROM node:22-alpine
WORKDIR /app
COPY package.json package-lock.json* ./
RUN npm install --no-audit --no-fund
# Standalone worker scripts import server-only guarded modules outside Next.js.
RUN printf 'module.exports = {};\n' > node_modules/server-only/index.js
COPY . .
ENV NODE_ENV=production
CMD ["npx", "tsx", "scripts/alert-worker.ts"]

    "@types/fontkit": "^2.0.9",
    "@types/node": "^22.0.0",
    "@types/nodemailer": "^6.4.24",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^6.1.0",
    "eslint": "^9.39.5",
    "eslint-config-next": "^15.5.23",
    "fontkit": "^2.0.4",
    "jsdom": "^29.1.1",
    "playwright": "^1.62.1",
    "tsx": "^4.23.12",
    "typescript": "^5.8.0",
    "vitest": "^4.1.11"

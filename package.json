  "scripts": {
    "dev": "env -u NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY -u CLERK_SECRET_KEY -u CLERK_PUBLISHABLE_KEY next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "docs:validate": "tsx scripts/docs-validate.ts",
    "glossary:validate": "tsx scripts/glossary-validate.ts",
    "content:validate": "tsx scripts/content-validate.ts",
    "brand:assets": "tsx scripts/export-brand-assets.ts",
    "repo:assets": "tsx scripts/export-repo-assets.ts",
    "readiness:rls": "tsx scripts/rls-inventory.ts",
    "readiness:secrets": "tsx scripts/secret-scan.ts",
    "oss:check": "tsx scripts/oss-check.ts",
    "oss:check:fast": "tsx scripts/oss-check.ts --skip-build",
    "oss:selfhost-check": "tsx scripts/oss-selfhost-check.ts",
    "oss:selfhost-check:fast": "tsx scripts/oss-selfhost-check.ts --skip-build --skip-docker",
    "selfhost:doctor": "tsx scripts/selfhost-doctor.ts",
    "selfhost:up": "docker compose up -d",
    "selfhost:down": "docker compose down",
    "selfhost:logs": "docker compose logs -f",
    "db:migrate": "tsx scripts/db-migrate.ts",
    "db:status": "tsx scripts/db-status.ts",
    "db:seed:demo": "tsx scripts/db-seed-demo.ts",
    "stripe:seed": "tsx scripts/stripe-seed-products.ts",
    "stripe:verify-prices": "tsx scripts/stripe-verify-prices.ts",
    "chat:knowledge": "tsx scripts/build-fajita-chat-knowledge.ts",
    "auth:sync-vercel": "./scripts/sync-vercel-auth-env.sh",
    "sitemap:audit": "tsx scripts/sitemap-audit.ts",
    "smoke:public": "tsx scripts/public-smoke.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.120.0",
    "@clerk/nextjs": "^7.8.1",
    "@datafast/ai-crawl": "^1.0.0",
    "@sentry/nextjs": "^10.71.0",
    "@supabase/supabase-js": "^2.112.4",
    "next": "^15.3.0",
    "nodemailer": "^9.0.5",
    "postgres": "^3.4.9",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "stripe": "^22.5.0",
    "zod": "^4.4.3"
